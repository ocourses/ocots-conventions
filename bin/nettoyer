#!/bin/sh
# Relais vers ocots-lint — l'outil de vérification est développé dans
# https://github.com/ocourses/ocots-lint (tests, garanties, releases).
#
#     ./conventions/bin/nettoyer [arguments]   ≡   ocots-lint nettoyer [arguments]
#
# La version d'ocots-lint est épinglée ici : un cours qui épingle une version
# des conventions obtient l'outil qui connaît ses règles.
#
# OCOTS_LINT remplace la commande, par exemple pour un clone local :
#     OCOTS_LINT="uv run --project ~/ocots-lint ocots-lint" ./conventions/bin/nettoyer
#
# Prérequis : uv (https://docs.astral.sh/uv/). Sans lui, sortie 2.

OCOTS_LINT_VERSION=v0.2.0

if [ -n "${OCOTS_LINT:-}" ]; then
  exec $OCOTS_LINT nettoyer "$@"
fi
if command -v uvx >/dev/null 2>&1; then
  exec uvx --quiet --from "git+https://github.com/ocourses/ocots-lint@$OCOTS_LINT_VERSION" \
    ocots-lint nettoyer "$@"
fi
echo "bin/nettoyer : uv est requis (relais vers ocots-lint $OCOTS_LINT_VERSION)." >&2
echo "  Installer : https://docs.astral.sh/uv/getting-started/installation/" >&2
exit 2
